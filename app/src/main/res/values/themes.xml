<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat parent required for per-app language (AppCompatDelegate.setApplicationLocales). -->
    <style name="Theme.PledgerIO" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.PledgerIO.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.PledgerIO</item>
        <item name="windowSplashScreenBackground">@color/pledger_cream</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_pledger_mark</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/pledger_cream</item>
    </style>
</resources>
